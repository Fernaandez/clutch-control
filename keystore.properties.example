# Copia aquest fitxer a keystore.properties i omple els valors reals.
# keystore.properties esta ignorat per git a proposit: no hi ha d'anar mai cap
# contrasenya ni cap .jks al repositori.
#
# Alternativa per a CI: en lloc del fitxer, defineix aquestes variables
# d'entorn: CC_KEYSTORE_FILE, CC_KEYSTORE_PASSWORD, CC_KEY_ALIAS, CC_KEY_PASSWORD
storeFile=clutch-release.jks
storePassword=
keyAlias=
keyPassword=
