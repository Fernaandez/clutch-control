# =====================================================================
# Clutch Control - Production environment template
# =====================================================================
# Copy these keys into Laravel Forge's "Environment" editor for your
# production site. Fill the placeholders with the real values you get
# from each provider (Hetzner, Cloudflare R2, Stripe, Firebase, Pusher).
#
# NEVER commit a real .env (with actual secrets) to git.
# =====================================================================

APP_NAME="Clutch Control"
APP_ENV=production
APP_KEY=                            # generated automatically by Forge on first deploy (php artisan key:generate)
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=ca
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ca_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------- Logging ----------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------- Database (Forge provisions MySQL) ----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clutch_control
DB_USERNAME=forge
DB_PASSWORD=                        # auto-generated by Forge

# ---------------- Sessions / Cache / Queue ----------------
# Start with database (simpler). When traffic grows, switch to redis
# (Forge has a one-click Redis install).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------- Filesystem: Cloudflare R2 (S3-compatible) ----------------
# Setting AWS_BUCKET is what triggers Storage::disk('public') to use R2.
# See config/filesystems.php.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=                  # R2 token "Access Key ID"
AWS_SECRET_ACCESS_KEY=              # R2 token "Secret Access Key"
AWS_DEFAULT_REGION=auto             # R2 uses "auto"
AWS_BUCKET=clutch-control-media     # name of the R2 bucket you created
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_URL=https://media.your-domain.com   # public custom domain on the bucket (via Cloudflare)
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------- Mail (Resend/Brevo/Mailgun/SES recommended over Gmail) ----------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- Broadcasting: Pusher (chat) ----------------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# ---------------- Firebase (FCM push notifications) ----------------
# Upload the service-account JSON to Forge under: /home/forge/your-domain.com/storage/app/firebase-credentials.json
FIREBASE_CREDENTIALS=/home/forge/your-domain.com/storage/app/firebase-credentials.json
FIREBASE_PROJECT_ID=

# ---------------- Google OAuth (Socialite) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ---------------- Vite ----------------
VITE_APP_NAME="${APP_NAME}"

# Stadia Maps — smooth dark tiles (Waze-like). Free tier at stadiamaps.com.
# Leave empty to use Carto Dark Matter fallback (also free).
VITE_STADIA_API_KEY=

# =====================================================================
# Future (Phase 5 - monetization):
# CASHIER_CURRENCY=eur
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# =====================================================================
